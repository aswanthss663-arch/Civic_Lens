# Node.js Express Backend Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civic_lens

# DATABASE_URL override (optional)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_lens

# Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Duplicate Detection Configuration
DUPLICATE_DISTANCE_METERS=500
DUPLICATE_THRESHOLD=0.80
